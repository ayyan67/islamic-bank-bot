{
  "name": "halal-economy-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Halal economy Discord bot built with Seyfert and SQLite",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "aliases:generate": "tsx scripts/generate-command-manifest.ts",
    "aliases:check": "pnpm aliases:generate && tsx scripts/check-aliases.ts && git diff --exit-code -- src/generated/commandManifest.ts",
    "smoke-check": "tsx scripts/smoke-check.ts",
    "stats": "tsx src/tools/stats.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "seyfert": "^4.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
